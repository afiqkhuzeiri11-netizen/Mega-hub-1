-- [ 4. LOGIKA LOOPING FITUR (WORKAROUND AMAN) ] --
RunService.Heartbeat:Connect(function()
    local char = Player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if hum then
            hum.WalkSpeed = walkSpeedVal
            if isGodMode then hum.Health = hum.MaxHealth end
        end

        if isNoclip then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        -- Auto Farming Objects (Pumpkin, Egg, Coins)
        if hrp and (isAutoPumpkin or isAutoEgg or isAutoCoin) then
            pcall(function()
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local name = obj.Name:lower()
                        local target = obj:IsA("Model") and obj.PrimaryPart or obj
                        if target then
                            if isAutoPumpkin and (name:find("pumpkin") or name:find("labu")) then
                                target.CFrame = hrp.CFrame
                            elseif isAutoEgg and (name:find("egg") or name:find("telur")) then
                                target.CFrame = hrp.CFrame
                            elseif isAutoCoin and (name:find("coin") or name:find("gem") or name:find("cash")) then
                                target.CFrame = hrp.CFrame
                            end
                        end
                    end
                end
            end)
        end
    end
end)

