-- [ 5. LOGIKA EKSEKUSI UTAMA ] --
task.spawn(function()
    while task.wait(0.4) do
        pcall(function()
            if not isAutoPumpkin and not isAutoEgg and not isAutoCoin then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            for _, obj in pairs(Workspace:GetDescendants()) do
                pcall(function()
                    if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                        local name = obj.Name:lower()
                        local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                        
                        if targetPart and targetPart:IsA("BasePart") then
                            local match = false
                            if isAutoPumpkin and (name:find("pumpkin") or name:find("labu") or name:find("event")) then
                                match = true
                            elseif isAutoEgg and (name:find("egg") or name:find("telur")) then
                                match = true
                            elseif isAutoCoin and (name:find("coin") or name:find("gem") or name:find("cash") or name:find("gold")) then
                                match = true
                            end
                            
                            if match then
                                hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                                task.wait(0.15)
                            end
                        end
                    end
                end)
            end
        end)
    end
end)

