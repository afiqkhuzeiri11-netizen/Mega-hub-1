local function addSection(titleText, yPos)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = Container
    lbl.Position = UDim2.new(0, 5, 0, yPos)
    lbl.Size = UDim2.new(1, -10, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.Text = titleText
    lbl.TextColor3 = Color3.fromRGB(0, 200, 255)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    return lbl
end

local function addToggle(text, yPos, callback)
    local Btn = Instance.new("TextButton")
    Btn.Parent = Container
    Btn.Position = UDim2.new(0, 0, 0, yPos)
    Btn.Size = UDim2.new(1, 0, 0, 36)
    Btn.BackgroundColor3 = Color3.fromRGB(22, 24, 38)
    Btn.Text = "  " .. text
    Btn.TextColor3 = Color3.fromRGB(180, 190, 210)
    Btn.TextSize = 11
    Btn.Font = Enum.Font.GothamBold
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)
    local Stroke = Instance.new("UIStroke")
    Stroke.Parent = Btn
    Stroke.Color = Color3.fromRGB(40, 45, 70)

    local Badge = Instance.new("TextLabel")
    Badge.Parent = Btn
    Badge.Position = UDim2.new(1, -60, 0, 7)
    Badge.Size = UDim2.new(0, 50, 0, 22)
    Badge.BackgroundColor3 = Color3.fromRGB(40, 20, 30)
    Badge.Text = "OFF"
    Badge.TextColor3 = Color3.fromRGB(255, 70, 90)
    Badge.TextSize = 10
    Badge.Font = Enum.Font.GothamBold
    Instance.new("UICorner", Badge).CornerRadius = UDim.new(0, 5)

    local active = false
    Btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            Badge.Text = "ON"
            Badge.TextColor3 = Color3.fromRGB(0, 255, 170)
            Badge.BackgroundColor3 = Color3.fromRGB(15, 45, 35)
            Stroke.Color = Color3.fromRGB(0, 255, 170)
        else
            Badge.Text = "OFF"
            Badge.TextColor3 = Color3.fromRGB(255, 70, 90)
            Badge.BackgroundColor3 = Color3.fromRGB(40, 20, 30)
            Stroke.Color = Color3.fromRGB(40, 45, 70)
        end
        callback(active)
    end)
end

