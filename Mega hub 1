-- [ 1. AGGRESSIVE ANTI-KICK & ANTI-BAN BYPASS ] --
pcall(function()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        -- Blokir semua upaya pemanggilan fungsi kick atau server disconnect
        if method and (method:lower() == "kick" or method:lower() == "loaddatabase" or method:lower() == "save") then
            if self == Player then
                warn("[Cyber Hub] Upaya Kick dari server berhasil diblokir!")
                return nil
            end
        end
        
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)

-- Lindungi fungsi Player:Kick asli
pcall(function()
    local OldKick; OldKick = hookmetamethod(Player, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if self == Player and method and method:lower() == "kick" then
            warn("[Cyber Hub] Player:Kick dicegat dan dinonaktifkan.")
            return
        end
        return OldKick(self, ...)
    end)
end)

